<UserControl x:Class="Albumen.App.PreviewStatusControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.Name="{Binding AutomationName}"
        AutomationProperties.ItemStatus="{Binding StatusText}">
    <StackPanel>
        <!-- MainWindow sizes the preview from the Review page viewport and the zoom
             slider; a zoomed photo pans sideways inside this scroller. -->
        <ScrollViewer x:Name="PreviewImageScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Focusable="False"
                      PreviewMouseWheel="OnPreviewImageMouseWheel">
            <Image x:Name="PreviewImage"
                   Source="{Binding Image, Mode=OneWay}"
                   MaxHeight="512"
                   HorizontalAlignment="Left"
                   Stretch="Uniform"
                   StretchDirection="Both"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="Active comparison preview" />
        </ScrollViewer>
        <TextBox x:Name="PreviewFullPathTextBox"
                 Text="{Binding FullPath, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 Background="{DynamicResource Albumen.SurfaceBrush}"
                 Foreground="{DynamicResource Albumen.TextBrush}"
                 AutomationProperties.Name="Full preview path" />
        <TextBlock x:Name="PreviewStatusText"
                   Text="{Binding StatusText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="{Binding StatusText}"
                   AutomationProperties.ItemStatus="{Binding StatusText}"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
