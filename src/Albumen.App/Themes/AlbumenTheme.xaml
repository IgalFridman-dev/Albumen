<!-- Albumen control styles. MainWindow merges this dictionary itself (tests construct
     MainWindow without App), so every style here is keyed and opt-in. Colours are the
     Albumen.*Brush palette tokens, always through DynamicResource: Themes/AlbumenPalette.cs
     writes them into the window and swaps them for system brushes under High Contrast. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Albumen.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Albumen.DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Keyboard focus ring shared by every themed control. -->
    <Style x:Key="Albumen.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="10" RadiusY="10" StrokeThickness="2"
                               Stroke="{DynamicResource Albumen.AccentBrush}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The 3 px blue-to-violet line that marks what is selected or current, and nothing
         else: the open category, the selected tab, the current step and each set label. -->
    <Style x:Key="Albumen.AccentLine" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="CornerRadius" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource Albumen.AccentLineBrush}" />
    </Style>

    <!-- The primary button's focus ring carries the same gradient. -->
    <Style x:Key="Albumen.PrimaryFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="19" RadiusY="19" StrokeThickness="2"
                               Stroke="{DynamicResource Albumen.AccentLineBrush}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text roles. -->
    <!-- Titles name their brush: a keyed style skips Fluent's implicit TextBlock style, and the
         inherited Foreground inside the Fluent tab content is black, not the window's. -->
    <Style x:Key="Albumen.PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Albumen.TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Albumen.DisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Albumen.SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Albumen.TextBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Albumen.MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Albumen.MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Albumen.Caption" TargetType="TextBlock" BasedOn="{StaticResource Albumen.MutedText}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A rounded surface a step lighter than the window. -->
    <Style x:Key="Albumen.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Albumen.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Albumen.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- High Contrast replaces the whole template rather than layering triggers on the
         themed one: only system colors, Highlight on hover, GrayText when disabled. The
         content is colored through TargetName because the style's High Contrast trigger
         owns the control's Foreground and outranks template triggers. -->
    <ControlTemplate x:Key="Albumen.HighContrastButtonTemplate" TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="8" SnapsToDevicePixels="True"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Albumen.HighContrastSwitchTemplate" TargetType="CheckBox">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" VerticalAlignment="Center"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="2">
                <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left"
                         Fill="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsEnabled" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Buttons: borderless pills as in Windows Photos; the variants only change colors.
         Under High Contrast every variant takes the system button template above, drawn on
         the window colours with a text-coloured outline. -->
    <Style x:Key="Albumen.Button" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Albumen.FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Albumen.PillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Albumen.TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="16" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Albumen.PillHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Albumen.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Template" Value="{StaticResource Albumen.HighContrastButtonTemplate}" />
                <Setter Property="Background" Value="{DynamicResource Albumen.SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Albumen.BorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource Albumen.TextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A destructive confirmation, such as clearing scan data. -->
    <Style x:Key="Albumen.DangerButton" TargetType="Button" BasedOn="{StaticResource Albumen.Button}">
        <Setter Property="Background" Value="{DynamicResource Albumen.DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Albumen.OnAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="16" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Albumen.DangerHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Albumen.DangerHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Albumen.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Albumen.Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Albumen.PrimaryFocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Albumen.AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Albumen.OnAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="16" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Albumen.AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Albumen.AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Albumen.LargePrimaryButton" TargetType="Button" BasedOn="{StaticResource Albumen.PrimaryButton}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="22,9" />
    </Style>

    <!-- On/off switch drawn over a real CheckBox, so commands, automation names and
         keyboard behavior stay those of a CheckBox. -->
    <Style x:Key="Albumen.SwitchCheckBox" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Albumen.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                Background="{DynamicResource Albumen.FieldBrush}"
                                BorderBrush="{DynamicResource Albumen.MutedTextBrush}" BorderThickness="1.5">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="4,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource Albumen.MutedTextBrush}" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Albumen.AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Albumen.AccentBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Albumen.OnAccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Width" Value="16" />
                            <Setter TargetName="Knob" Property="Height" Value="16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Template" Value="{StaticResource Albumen.HighContrastSwitchTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A read-only path shown as text rather than as an input box. -->
    <Style x:Key="Albumen.PathText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Albumen.TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Albumen.FocusVisual}" />
    </Style>

    <ControlTemplate x:Key="Albumen.HighContrastStepTemplate" TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="10" Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </MultiTrigger>
            <!-- Step content is the button's logical child, so it inherits the button's
                 Foreground rather than the presenter's; set both. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Workflow step in the left rail. -->
    <Style x:Key="Albumen.StepButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Albumen.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Albumen.TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="10" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Albumen.SubtleFillBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Template" Value="{StaticResource Albumen.HighContrastStepTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Review: a whole card that opens something (a kind or a set). In High Contrast it
         keeps system colors and shows hover and the open item with a Highlight border. -->
    <ControlTemplate x:Key="Albumen.HighContrastCardTemplate" TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="10" Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Albumen.CardButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Albumen.FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Albumen.SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Albumen.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Albumen.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="10" SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Albumen.BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Albumen.PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Template" Value="{StaticResource Albumen.HighContrastCardTemplate}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Albumen.BorderStrongBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A photo thumbnail that opens the photo in the viewer. The photo sits on the dark
         ground; only hover draws a border, and High Contrast an outline. -->
    <Style x:Key="Albumen.ThumbnailButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Albumen.FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Albumen.SubtleFillBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="8" ClipToBounds="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Albumen.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Albumen.BorderStrongBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <!-- A small rounded label on a photo card. -->
    <Style x:Key="Albumen.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,4,6,0" />
        <Setter Property="Background" Value="{DynamicResource Albumen.SubtleFillBrush}" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <!-- High Contrast: window colours with an outline instead of a fill. -->
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Albumen.SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Albumen.BorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Albumen.TextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A result label colored by its Tag, an ActionResultTone (Waiting, Busy, Done, Skipped, Warning). -->
    <Style x:Key="Albumen.ToneChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{DynamicResource Albumen.SubtleFillBrush}" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Busy">
                <Setter Property="Background" Value="{DynamicResource Albumen.AccentSoftBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Albumen.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Done">
                <Setter Property="Background" Value="{DynamicResource Albumen.SuccessSoftBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Albumen.SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Albumen.WarningSoftBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Albumen.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Albumen.SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Albumen.BorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Albumen.TextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A full-width message in the same tone colors, for the result of a cleanup. -->
    <Style x:Key="Albumen.ToneBanner" TargetType="Border" BasedOn="{StaticResource Albumen.ToneChip}">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextElement.FontWeight" Value="Normal" />
    </Style>

    <!-- The top bar: the views as a row of pills above the selected view. -->
    <ControlTemplate x:Key="Albumen.HighContrastTopBarItemTemplate" TargetType="TabItem">
        <Border x:Name="Chrome" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,2,0" BorderThickness="1"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="Transparent">
            <ContentPresenter x:Name="Header" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center"
                              TextElement.FontWeight="SemiBold"
                              TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- A tab's content inherits the tab's text properties, so the header is styled on its
         presenter, never on the TabItem itself. -->
    <Style x:Key="Albumen.TopBarItem" TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Albumen.FocusVisual}" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- The accent line lies over the pill's left edge, so selecting a tab moves nothing. -->
                    <Grid Margin="0,0,2,0" SnapsToDevicePixels="True">
                        <Border x:Name="Chrome" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter x:Name="Header" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{DynamicResource Albumen.MutedTextBrush}" />
                        </Border>
                        <Border x:Name="AccentLine" Style="{StaticResource Albumen.AccentLine}" HorizontalAlignment="Left"
                                Margin="1,7" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Albumen.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Albumen.PillBrush}" />
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource Albumen.TextBrush}" />
                            <Setter TargetName="AccentLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Template" Value="{StaticResource Albumen.HighContrastTopBarItemTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The photo search bar: one short rounded field, like the taskbar's search box, with an
         accent outline while it has keyboard focus. It grows only for large text. -->
    <Style x:Key="Albumen.SearchBar" TargetType="Border">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Albumen.FieldBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Albumen.BorderStrongBrush}" />
            </DataTrigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Albumen.AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The bar's text box: only the text and its caret; the bar draws the field around it. -->
    <Style x:Key="Albumen.SearchBox" TargetType="TextBox">
        <!-- The Fluent TextBox style would otherwise impose MinHeight 32 and grow the 32 px bar. -->
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="Foreground" Value="{DynamicResource Albumen.TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Albumen.TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A round icon button inside the search bar (the magnifier and the clear button). -->
    <Style x:Key="Albumen.SearchBarButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Albumen.FocusVisual}" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Albumen.MutedTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="14" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Albumen.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Albumen.PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Template" Value="{StaticResource Albumen.HighContrastButtonTemplate}" />
                <Setter Property="Foreground" Value="{DynamicResource Albumen.TextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The top bar's row holds the tab strip on the left and, centred in the rest of the row,
         whatever the window puts in the TabControl's Tag (the photo search bar). -->
    <Style x:Key="Albumen.TopBar" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <!-- Every page lives in this control's content, and text that has no brush of its own
             inherits from here; without this the Golden VM showed it black on the dark ground. -->
        <Setter Property="Foreground" Value="{DynamicResource Albumen.TextBrush}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Albumen.TopBarItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- The strip takes the width it needs, so it never wraps at large text; the
                             empty right column shares that width, so the middle stays centred. -->
                        <Grid x:Name="HeaderRow" Grid.IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="TopBarSide" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="TopBarSide" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Strip" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0"
                                    Padding="3" CornerRadius="10" Background="{DynamicResource Albumen.SubtleFillBrush}">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter x:Name="HeaderCenter" Grid.Column="1" Content="{TemplateBinding Tag}" />
                        </Grid>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}" KeyboardNavigation.TabNavigation="Local" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                            <Setter TargetName="Strip" Property="Background" Value="{DynamicResource Albumen.SurfaceBrush}" />
                            <Setter TargetName="Strip" Property="BorderBrush" Value="{DynamicResource Albumen.BorderStrongBrush}" />
                            <Setter TargetName="Strip" Property="BorderThickness" Value="1" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
