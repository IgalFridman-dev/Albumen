<Window x:Class="PhotoSift.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PhotoSift"
        Width="960"
        Height="720"
        MinWidth="680"
        MinHeight="520"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ReviewListStyle" TargetType="ListBox">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="OccurrenceTemplate">
            <StackPanel Margin="4,6">
                <TextBlock Text="{Binding PathKind}" FontWeight="SemiBold" />
                <TextBox Text="{Binding DiscoveredPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         AutomationProperties.Name="Discovered file path" />
                <TextBox Text="{Binding ResolvedPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         AutomationProperties.Name="Resolved file path" />
                <TextBlock Text="{Binding PhysicalIdentity}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ByteLength, StringFormat='Content length: {0} bytes'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Allocation}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock FontSize="30"
                       FontWeight="SemiBold"
                       Text="PhotoSift" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="16"
                       TextWrapping="Wrap"
                       Text="Choose one local photo folder. PhotoSift checks it without changing or uploading your photos." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PhaseRail"
                              AutomationProperties.Name="Workflow phases"
                              ItemsSource="{Binding Phases}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="12"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="{Binding DisplayName}" />
                                    <TextBlock Grid.Row="1"
                                               Margin="0,3,0,8"
                                               Text="{Binding AvailabilityLabel}" />
                                    <Button Grid.Row="2"
                                            MinHeight="32"
                                            Padding="10,5"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Phase}"
                                            Content="{Binding DisplayName}"
                                            IsEnabled="{Binding IsAvailable}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" Visibility="{Binding IsChooseScopePhase, Converter={StaticResource BooleanToVisibilityConverter}}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Text="Choose Scope" />

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="ScopeStatusIcon"
                                  Width="18"
                                  Height="18"
                                  Margin="0,2,10,0"
                                  VerticalAlignment="Top"
                                  AutomationProperties.ItemStatus="{Binding ScopeStatus}"
                                  AutomationProperties.Name="{Binding ScopeStatus, StringFormat='Scope status: {0}'}"
                                  Fill="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data"
                                                Value="M 9,0 L 18,9 L 9,18 L 0,9 Z" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                <Setter Property="Data"
                                                        Value="M 1,9 L 6,14 L 17,3 L 14,0 L 6,8 L 4,6 Z" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                <Setter Property="Data"
                                                        Value="M 9,0 L 18,18 L 0,18 Z M 8,5 L 10,5 L 10,12 L 8,12 Z M 8,14 L 10,14 L 10,16 L 8,16 Z" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="ScopeStatusText"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           AutomationProperties.HelpText="{Binding Instruction}"
                                           AutomationProperties.ItemStatus="{Binding ScopeStatus}"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="Scope status"
                                           Text="{Binding ScopeStatus}" />
                                <TextBlock Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Text="{Binding Instruction}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="BlockingNotice"
                            Margin="0,14,0,0"
                            Padding="14"
                            Focusable="True"
                            AutomationProperties.Name="{Binding BlockingNoticeAutomationName}"
                            Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1"
                            TextElement.Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                            Visibility="{Binding IsBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="This folder cannot be used yet." />
                            <ItemsControl Margin="0,6,0,0"
                                          AutomationProperties.Name="Blocking reasons"
                                          ItemsSource="{Binding BlockingReasons}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Selected Scope" />
                        <TextBox x:Name="SelectedPathTextBox"
                                 Margin="0,5,0,0"
                                 Padding="8"
                                 IsReadOnly="True"
                                 Text="{Binding SelectedPath, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="Selected Scope" />

                        <TextBlock Margin="0,12,0,0"
                                   FontWeight="SemiBold"
                                   Text="Resolved Scope" />
                        <TextBox x:Name="ResolvedPathTextBox"
                                 Margin="0,5,0,0"
                                 Padding="8"
                                 IsReadOnly="True"
                                 Text="{Binding ResolvedPath, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="Resolved Scope" />

                        <CheckBox x:Name="IncludeSubfoldersCheckBox"
                                  Margin="0,14,0,0"
                                  AutomationProperties.Name="Include subfolders"
                                  Command="{Binding ChangeRecursionCommand}"
                                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                  Content="Include subfolders"
                                  IsEnabled="{Binding CanChangeRecursion}"
                                  IsChecked="{Binding IncludeSubfolders, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Margin="0,18,0,0"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="Preflight summary" />
                    <ItemsControl x:Name="ScopeSummaryList"
                                  Margin="0,8,0,0"
                                  AutomationProperties.Name="Scope preflight summary"
                                  ItemsSource="{Binding ScopeSummary}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,0,0"
                                               FontWeight="SemiBold"
                                               Text="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="RuleSetStatusText"
                               Margin="0,14,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding RuleSetStatus, StringFormat='Rule Set: {0}'}" />

                    <WrapPanel Margin="0,18,0,0">
                        <Button x:Name="ChooseAnotherScopeButton"
                                MinWidth="160"
                                MinHeight="36"
                                Margin="0,0,10,10"
                                Padding="14,7"
                                AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                Command="{Binding ChooseScopeCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="Choose folder" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                            <Setter Property="Content" Value="Choose another folder" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                            <Setter Property="Content" Value="Choose another folder" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="Content" Value="Choose another folder" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                            <Setter Property="Content" Value="Choose another folder" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="RetryScopeButton"
                                MinWidth="160"
                                MinHeight="36"
                                Margin="0,0,10,10"
                                Padding="14,7"
                                AutomationProperties.Name="Retry Scope verification"
                                Command="{Binding RetryScopeCommand}"
                                Content="Retry verification">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="ContinueButton" MinHeight="36" Padding="14,7" Margin="0,0,10,10"
                                Content="Continue" AutomationProperties.Name="Continue to Confirm Rules"
                                Command="{Binding ContinueCommand}" IsEnabled="{Binding CanContinue}" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsConfirmRulesPhase, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Confirm Rules" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Selected Scope" Margin="0,16,0,4" FontWeight="SemiBold" />
                    <TextBox Text="{Binding SelectedPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             AutomationProperties.Name="Scope for Exact rules" />
                    <TextBlock Text="{Binding RecursionSummary}" Margin="0,8" />
                    <TextBlock Text="{Binding ExactPreset}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Visual and semantic matching are unavailable in this milestone." TextWrapping="Wrap" Margin="0,10" />
                    <TextBlock Text="{Binding RuleSetStatus}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="ConfirmExactRulesButton" Content="Confirm Exact rules" Padding="12,8" Margin="0,0,10,10"
                                AutomationProperties.Name="Confirm Exact rules" Command="{Binding ConfirmExactRulesCommand}"
                                IsEnabled="{Binding CanConfirmExactRules}" />
                        <Button x:Name="StartScanButton" Content="Start Scan" Padding="12,8" Margin="0,0,10,10"
                                AutomationProperties.Name="Start Scan" Command="{Binding StartScanCommand}" IsEnabled="{Binding CanStartScan}" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2" Visibility="{Binding IsScanPhase, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Scan" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="ScanStatusText" Text="{Binding ScanStatus}" TextWrapping="Wrap" Margin="0,16,0,8"
                               AutomationProperties.Name="Scan status" AutomationProperties.ItemStatus="{Binding ScanStatus}"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar Height="8" IsIndeterminate="{Binding IsScanBusy}" AutomationProperties.Name="Scan activity"
                                 AutomationProperties.ItemStatus="{Binding ScanStatus}" />
                    <TextBlock Text="{Binding ScanCountsText}" TextWrapping="Wrap" Margin="0,12" />
                    <TextBlock Text="{Binding CoverageStatus}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="CancelScanButton" Content="Cancel Scan" Padding="12,8" Margin="0,0,10,10"
                                AutomationProperties.Name="Cancel Scan" Command="{Binding CancelScanCommand}" IsEnabled="{Binding IsScanBusy}" />
                        <Button Content="Open Review" Padding="12,8" Margin="0,0,10,10" AutomationProperties.Name="Open Review"
                                Command="{Binding OpenReviewCommand}" IsEnabled="{Binding CanOpenReview}" />
                        <Button Content="Scan again" Padding="12,8" Margin="0,0,10,10" AutomationProperties.Name="Start a fresh scan"
                                Command="{Binding StartScanCommand}" IsEnabled="{Binding CanStartScan}" />
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <!-- Finite Grid rows let each native list own its scroll viewport.
                 An outer ScrollViewer would disable inventory virtualization. -->
            <Grid Grid.Column="2" Visibility="{Binding IsReviewPhase, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="3*" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ReviewHeading" Text="Review" FontSize="24" FontWeight="SemiBold" Focusable="True"
                               AutomationProperties.Name="Read-only Exact review" />
                                        <TextBlock x:Name="ReviewStatusText" Text="{Binding ScanStatus}" TextWrapping="Wrap"
                               AutomationProperties.Name="Review scan status" AutomationProperties.ItemStatus="{Binding ScanStatus}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding CoverageStatus}" TextWrapping="Wrap" Margin="0,8" />
                    <TextBlock Text="{Binding ScanCountsText}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Exact groups" FontWeight="SemiBold" Margin="0,10,0,4" />
                <ListBox x:Name="ExactGroupsList" Grid.Row="2" ItemsSource="{Binding ExactGroups}"
                         Style="{StaticResource ReviewListStyle}" AutomationProperties.Name="Exact duplicate groups">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,8">
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PotentialRecovery}" TextWrapping="Wrap" Margin="0,4" />
                                <ListBox ItemsSource="{Binding Members}" MaxHeight="220" Style="{StaticResource ReviewListStyle}"
                                         ItemTemplate="{StaticResource OccurrenceTemplate}" AutomationProperties.Name="Physical files and alias paths" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3" Text="Could Not Analyze" FontWeight="SemiBold" Margin="0,10,0,4" />
                <ListBox x:Name="CouldNotAnalyzeList" Grid.Row="4" ItemsSource="{Binding CouldNotAnalyze}"
                         Style="{StaticResource ReviewListStyle}" ItemTemplate="{StaticResource OccurrenceTemplate}"
                         AutomationProperties.Name="Could Not Analyze" />
                <StackPanel Grid.Row="5" Margin="0,10,0,0">
                    <TextBlock Text="{Binding ReviewDisclaimer}" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Content="Cancel Scan" Padding="10,6" Margin="0,6,8,0" AutomationProperties.Name="Cancel Scan from Review"
                                Command="{Binding CancelScanCommand}" IsEnabled="{Binding IsScanBusy}" />
                        <Button Content="Scan again" Padding="10,6" Margin="0,6,8,0" AutomationProperties.Name="Start a fresh scan from Review"
                                Command="{Binding StartScanCommand}" IsEnabled="{Binding CanStartScan}" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Text="No account or network connection is required. Your source photos remain unchanged." />
    </Grid>
</Window>


