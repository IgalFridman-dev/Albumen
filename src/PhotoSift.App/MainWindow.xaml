<Window x:Class="PhotoSift.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:PhotoSift.App"
        xmlns:shell="clr-namespace:PhotoSift.App.Shell"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PhotoSift"
        Width="960"
        Height="720"
        MinWidth="680"
        MinHeight="520"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.SelectAll"
                        CanExecute="OnCanSelectFocusedReviewGroup"
                        Executed="OnSelectFocusedReviewGroup" />
    </Window.CommandBindings>
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/PhotoSift.App;component/Themes/PhotoSiftTheme.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ActionFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" StrokeThickness="2" StrokeDashArray="1,1"
                                   Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFB3261E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ActionFocusVisual}" />
        </Style>
        <DataTemplate x:Key="ScanOutcomeSummaryTemplate">
            <StackPanel Margin="0,2">
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="{Binding Label}" />
                    <Run Text=": " />
                    <Run Text="{Binding Count, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <!-- One photo in a cleanup: what it is, where it was, and what happened to it. -->
        <DataTemplate x:Key="ActionItemTemplate">
            <app:ReviewAutomationBorder Margin="0,4" Padding="14,10" BorderThickness="1" CornerRadius="10"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    AutomationProperties.AutomationId="action-item"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.ItemStatus="{Binding ItemStatus}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource PhotoSift.ToneChip}"
                                Tag="{Binding Tone}">
                            <TextBlock Text="{Binding ResultLabel}" FontSize="12" />
                        </Border>
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBox Text="{Binding OriginalPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,0"
                             Style="{StaticResource PhotoSift.PathText}"
                             AutomationProperties.Name="{Binding AutomationName}"
                             AutomationProperties.ItemStatus="{Binding ItemStatus}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding DetailText}" TextWrapping="Wrap"
                               Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </app:ReviewAutomationBorder>
        </DataTemplate>
        <DataTemplate x:Key="ActionRecordItemTemplate">
            <app:ReviewAutomationBorder Margin="0,8,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    AutomationProperties.AutomationId="action-record-item"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.ItemStatus="{Binding StatusText}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource PhotoSift.ToneChip}"
                                Tag="{Binding Tone}">
                            <TextBlock Text="{Binding ResultText}" FontSize="12" />
                        </Border>
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBox Text="{Binding OriginalPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,0"
                             Style="{StaticResource PhotoSift.PathText}"
                             AutomationProperties.Name="Action record original path"
                             AutomationProperties.ItemStatus="{Binding StatusText}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding DetailText}" TextWrapping="Wrap"
                               Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ProgressBar Height="6" Margin="0,6,0,0" IsIndeterminate="{Binding IsVerifying}"
                                 Visibility="{Binding IsVerifying, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.Name="Current file state verification progress"
                                 AutomationProperties.ItemStatus="{Binding StatusText}" />
                </StackPanel>
            </app:ReviewAutomationBorder>
        </DataTemplate>
        <!-- One saved cleanup: when it ran, how it ended, and every photo in it. -->
        <DataTemplate x:Key="ActionRecordHistoryTemplate">
            <Border Margin="0,0,0,12" Style="{StaticResource PhotoSift.Card}" Padding="18,14">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource PhotoSift.ToneChip}"
                                Tag="{Binding Tone}">
                            <TextBlock Text="{Binding OutcomeLabel}" FontSize="12" />
                        </Border>
                        <TextBlock Text="{Binding DateText, StringFormat='Cleanup on {0}'}" Style="{StaticResource PhotoSift.SectionTitle}" />
                    </DockPanel>
                    <TextBlock Margin="0,2,0,0" Text="{Binding SummaryText}" Style="{StaticResource PhotoSift.MutedText}" />
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ActionRecordItemTemplate}" Focusable="False" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="ReviewListStyle" TargetType="ListBox">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="OccurrenceTemplate">
            <StackPanel Margin="4,6">
                <TextBlock Text="{Binding PathKind}" FontWeight="SemiBold" />
                <TextBox Text="{Binding DiscoveredPath, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap"
                         AutomationProperties.Name="Discovered file path" />
                <TextBox Text="{Binding ResolvedPath, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap"
                         AutomationProperties.Name="Resolved file path" />
                <TextBlock Text="{Binding PhysicalIdentity}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ByteLength, StringFormat='Content length: {0} bytes'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Allocation}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding OutcomeLabel}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ReviewOccurrenceTemplate">
            <StackPanel Margin="4,6">
                <app:ReviewSelectionCheckBox MinHeight="34"
                          Padding="4"
                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                          IsEnabled="{Binding CanSelect}"
                          Command="{Binding ToggleSelectionCommand}"
                          AutomationProperties.AutomationId="selection-control"
                          AutomationProperties.Name="{Binding AutomationName}"
                          AutomationProperties.ItemStatus="{Binding ItemStatus}"
                           Content="{Binding EligibilityText}" />
                <TextBlock Text="{Binding PathKind}" FontWeight="SemiBold" />
                <TextBox Text="{Binding DiscoveredPath, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"
                         TextWrapping="Wrap" AutomationProperties.Name="Discovered file path" />
                <TextBox Text="{Binding ResolvedPath, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"
                         TextWrapping="Wrap" AutomationProperties.Name="Resolved file path" />
                <TextBlock Text="{Binding PhysicalIdentity}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ByteLength, StringFormat='Content length: {0} bytes'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Allocation}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <app:EqualValuesConverter x:Key="EqualValuesConverter" />
        <app:EqualValuesToVisibilityConverter x:Key="EqualValuesToVisibilityConverter" />
        <!-- A kind of result (Identical copies, Look-alike, Maybe similar, couldn't check). -->
        <DataTemplate x:Key="ReviewCategoryTemplate">
            <Button MinHeight="44" Margin="2,3" Click="OnOpenReviewCategoryClick"
                    AutomationProperties.AutomationId="open-review-category"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.PositionInSet="{Binding PositionInSet}"
                    AutomationProperties.SizeOfSet="{Binding SizeOfSet}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PhotoSift.CardButton}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Value="True">
                                        <Condition.Binding>
                                            <MultiBinding Converter="{StaticResource EqualValuesConverter}">
                                                <Binding Path="Category" />
                                                <Binding Path="DataContext.ActiveReviewCategory.Category" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Condition.Binding>
                                    </Condition>
                                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{StaticResource PhotoSift.AccentSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PhotoSift.AccentBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Value="True">
                                        <Condition.Binding>
                                            <MultiBinding Converter="{StaticResource EqualValuesConverter}">
                                                <Binding Path="Category" />
                                                <Binding Path="DataContext.ActiveReviewCategory.Category" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Condition.Binding>
                                    </Condition>
                                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PhotoSift.KindMark}" Margin="0,2,10,2" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource PhotoSift.Caption}" Text="{Binding Description}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Margin="10,0,0,0" FontWeight="SemiBold" Text="{Binding CountText}" />
                </Grid>
            </Button>
        </DataTemplate>
        <!-- One set of photos inside the open kind. -->
        <DataTemplate x:Key="ReviewGroupTemplate">
            <Button MinHeight="44" Margin="2,3" Click="OnOpenReviewGroupClick"
                    AutomationProperties.AutomationId="open-review-group"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.ItemStatus="{Binding ItemStatus}"
                    AutomationProperties.PositionInSet="{Binding PositionInSet}"
                    AutomationProperties.SizeOfSet="{Binding SizeOfSet}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PhotoSift.CardButton}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Value="True">
                                        <Condition.Binding>
                                            <MultiBinding Converter="{StaticResource EqualValuesConverter}">
                                                <Binding Path="GroupId" />
                                                <Binding Path="DataContext.ActiveReviewGroup.GroupId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Condition.Binding>
                                    </Condition>
                                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{StaticResource PhotoSift.AccentSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PhotoSift.AccentBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Value="True">
                                        <Condition.Binding>
                                            <MultiBinding Converter="{StaticResource EqualValuesConverter}">
                                                <Binding Path="GroupId" />
                                                <Binding Path="DataContext.ActiveReviewGroup.GroupId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Condition.Binding>
                                    </Condition>
                                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.Style>
                        <!-- A set settled by marks held in other sets reads as done: dimmed,
                             except in High Contrast where the caption alone says so. -->
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSettledElsewhere}" Value="True" />
                                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Opacity" Value="0.55" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PhotoSift.KindMark}" Margin="0,2,10,2" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource PhotoSift.Caption}" Text="{Binding SelectionStatus}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <!-- One photo of the open set: thumbnail (opens the viewer), name, the Keep / Remove
             control near the top so it stays reachable at large text sizes, then path, facts
             and badges. The selection control's direct parent
             stays a StackPanel (acceptance tests swap it in place). -->
        <DataTemplate x:Key="ReviewComparisonTemplate">
            <Border x:Name="PhotoCard" Margin="2,3" Padding="10" CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                        <Setter Property="BorderBrush" Value="{StaticResource PhotoSift.BorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource EqualValuesConverter}">
                                        <Binding Path="OccurrenceId" />
                                        <Binding Path="DataContext.ActiveReviewMember.OccurrenceId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="BorderBrush" Value="{StaticResource PhotoSift.AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Value="True">
                                        <Condition.Binding>
                                            <MultiBinding Converter="{StaticResource EqualValuesConverter}">
                                                <Binding Path="OccurrenceId" />
                                                <Binding Path="DataContext.ActiveReviewMember.OccurrenceId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Condition.Binding>
                                    </Condition>
                                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Compare sits under the thumbnail so it is never clipped by a narrow card. -->
                    <StackPanel Grid.Column="0" Width="124" VerticalAlignment="Top">
                        <Button Width="112" Height="84" VerticalAlignment="Top" Margin="0,0,12,0"
                                Style="{StaticResource PhotoSift.ThumbnailButton}"
                                Click="OnOpenReviewMemberClick"
                                ToolTip="Open in the viewer"
                                AutomationProperties.AutomationId="open-review-member"
                                AutomationProperties.Name="{Binding AutomationName}"
                                AutomationProperties.ItemStatus="{Binding ItemStatus}"
                                AutomationProperties.PositionInSet="{Binding PositionInSet}"
                                AutomationProperties.SizeOfSet="{Binding SizeOfSet}">
                            <app:PhotoThumbnail x:Name="Thumbnail" Member="{Binding}"
                                    Loader="{Binding DataContext.ReviewThumbnails, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Button>
                        <!-- The photo already in the viewer has nothing to be compared with. -->
                        <Button Content="Compare" Margin="0,6,12,0" MinHeight="32" Padding="6,4" HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.CompareReviewMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Show this photo beside the one in the viewer"
                                AutomationProperties.Name="{Binding FileName, StringFormat='Compare {0} with the photo in the viewer'}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PhotoSift.Button}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource EqualValuesConverter}">
                                                    <Binding Path="OccurrenceId" />
                                                    <Binding Path="DataContext.ActiveReviewMember.OccurrenceId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <app:ReviewSelectionCheckBox x:Name="ReviewSelectionCheckBox" MinHeight="34"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource PhotoSift.KeepRemoveToggle}"
                                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                                    IsEnabled="{Binding CanSelect}"
                                    Command="{Binding ToggleSelectionCommand}"
                                    AutomationProperties.AutomationId="selection-control"
                                    AutomationProperties.Name="{Binding AutomationName}"
                                    AutomationProperties.ItemStatus="{Binding ItemStatus}"
                                    Content="{Binding EligibilityText}" />
                        </StackPanel>
                        <TextBox Text="{Binding DiscoveredPath, Mode=OneWay}" IsReadOnly="True"
                                 IsTabStop="False" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                 Style="{StaticResource PhotoSift.PathText}"
                                 AutomationProperties.Name="{Binding DiscoveredPath}" />
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Margin="0,0,12,0" Style="{StaticResource PhotoSift.Caption}" Text="{Binding SizeText}" />
                            <TextBlock Style="{StaticResource PhotoSift.Caption}"
                                       Text="{Binding DimensionsText, ElementName=Thumbnail}" />
                        </WrapPanel>
                        <WrapPanel>
                            <Border Style="{StaticResource PhotoSift.Badge}">
                                <Border.Visibility>
                                    <MultiBinding Converter="{StaticResource EqualValuesToVisibilityConverter}">
                                        <Binding Path="OccurrenceId" />
                                        <Binding Path="DataContext.ActiveReviewSuggestion.OccurrenceId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </Border.Visibility>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Suggested best:" />
                                    <Run Text="{Binding DataContext.ActiveReviewSuggestion.Reason, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource PhotoSift.Badge}"
                                    Visibility="{Binding IsAliasPath, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Another path to the same file" TextWrapping="Wrap" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
    <!-- Decorative soft glow behind the workflow. Hidden in High Contrast and while
         reviewing photos, where a tinted background would distort how colors look. -->
    <Grid x:Name="BackgroundGlow" IsHitTestVisible="False" ClipToBounds="True">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReviewPhase}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.05,-0.1" GradientOrigin="0.05,-0.1" RadiusX="0.75" RadiusY="0.8">
                    <GradientStop Color="#FFDCE7FF" Offset="0" />
                    <GradientStop Color="#00DCE7FF" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,-0.05" GradientOrigin="1,-0.05" RadiusX="0.6" RadiusY="0.75">
                    <GradientStop Color="#FFEFE4FF" Offset="0" />
                    <GradientStop Color="#00EFE4FF" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.6,1.1" GradientOrigin="0.6,1.1" RadiusX="0.6" RadiusY="0.7">
                    <GradientStop Color="#FFDDF5EE" Offset="0" />
                    <GradientStop Color="#00DDF5EE" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Column="0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="9" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource PhotoSift.AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 3,6 L 15,6 L 15,18 L 3,18 Z M 7,3 L 18,3 L 18,14 M 5,15 L 8,11.5 L 11,14.5 L 13,12.5">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="White" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <WrapPanel>
                        <TextBlock FontFamily="{StaticResource PhotoSift.DisplayFontFamily}" FontSize="20"
                                   FontWeight="SemiBold" Text="PhotoSift" Margin="0,0,12,0" />
                        <Border Margin="0,3,0,0" Padding="10,2" CornerRadius="10" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource PhotoSift.SuccessSoftBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource PhotoSift.SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Offline · nothing is uploaded" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
            <!-- Shown only while Action records load or after local data failed to load. -->
            <Border x:Name="LocalDataStatusBanner" Grid.Row="1" Grid.ColumnSpan="2"
                    Margin="0,8,0,0" CornerRadius="4"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Visibility="{Binding HasActionRecoveryStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocalDataFaulted}" Value="True">
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top" Stretch="Uniform"
                          Fill="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                          Data="M 9,0 L 18,18 L 0,18 Z M 8,5 L 10,5 L 10,12 L 8,12 Z M 8,14 L 10,14 L 10,16 L 8,16 Z"
                          Visibility="{Binding IsLocalDataFaulted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock x:Name="LocalDataStatusText" Grid.Column="1"
                               Text="{Binding ActionRecoveryStatusText}" TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding ActionRecoveryStatusText}"
                               AutomationProperties.ItemStatus="{Binding ActionRecoveryStatusText}"
                               AutomationProperties.AutomationId="local-data-status">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLocalDataFaulted}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Style="{StaticResource PhotoSift.TopBar}" Padding="8,6,4,4"
                    AutomationProperties.Name="PhotoSift views">
          <TabItem Header="Photos" IsSelected="True" AutomationProperties.Name="Photos">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PhaseRail"
                              Margin="4,4,0,0"
                              AutomationProperties.Name="Workflow steps"
                              ItemsSource="{Binding RailSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,8,4"
                                    MinHeight="52"
                                    Padding="10,6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding DisplayName}"
                                    AutomationProperties.ItemStatus="{Binding AvailabilityLabel}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Phase}"
                                    IsEnabled="{Binding IsAvailable}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PhotoSift.StepButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource PhotoSift.AccentBrush}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCurrent}" Value="True" />
                                                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource PhotoSift.SubtleFillBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PhotoSift.AccentBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="White" />
                                                    </DataTrigger>
                                                    <!-- In High Contrast the number follows the step's own text color,
                                                         so an unavailable step reads as GrayText throughout. -->
                                                    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        <Setter Property="TextElement.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding StepNumber}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding DisplayName}" />
                                        <TextBlock Text="{Binding AvailabilityLabel}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PhotoSift.Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Column="2" Visibility="{Binding IsChooseFolderPhase, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- The page fits 1280×800 without scrolling; the ScrollViewer is for smaller windows. -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,4,20,8" MaxWidth="760" HorizontalAlignment="Stretch">

                        <!-- Hero: the illustration, the headline and one line. -->
                        <Grid x:Name="FolderHero">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Four tilted photo cards, drawn as XAML geometry; decorative, so it
                                 is hidden from automation and under High Contrast. -->
                            <Canvas x:Name="HeroIllustration" Width="176" Height="104" Margin="0,0,24,0">
                                <Canvas.Style>
                                    <Style TargetType="Canvas">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Canvas.Style>
                                <Canvas.Resources>
                                    <Style x:Key="HeroPhoto" TargetType="Border">
                                        <Setter Property="Width" Value="64" />
                                        <Setter Property="Height" Value="52" />
                                        <Setter Property="CornerRadius" Value="6" />
                                        <Setter Property="Padding" Value="4" />
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PhotoSift.BorderStrongBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12" />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="HeroSky" TargetType="Rectangle">
                                        <Setter Property="RadiusX" Value="3" />
                                        <Setter Property="RadiusY" Value="3" />
                                        <Setter Property="Fill">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#DCE7FF" Offset="0" />
                                                    <GradientStop Color="#EFF4FF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="HeroHill" TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource PhotoSift.AccentBrush}" />
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Setter Property="Stretch" Value="Fill" />
                                        <Setter Property="Data" Value="M 0,44 L 16,24 L 26,34 L 38,18 L 56,44 Z" />
                                    </Style>
                                    <Style x:Key="HeroSun" TargetType="Ellipse">
                                        <Setter Property="Width" Value="10" />
                                        <Setter Property="Height" Value="10" />
                                        <Setter Property="Fill" Value="#F5C38B" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Setter Property="Margin" Value="0,6,8,0" />
                                    </Style>
                                </Canvas.Resources>
                                <Border Style="{StaticResource HeroPhoto}" Canvas.Left="2" Canvas.Top="30">
                                    <Border.RenderTransform><RotateTransform Angle="-14" /></Border.RenderTransform>
                                    <Grid><Rectangle Style="{StaticResource HeroSky}" /><Path Style="{StaticResource HeroHill}" /><Ellipse Style="{StaticResource HeroSun}" /></Grid>
                                </Border>
                                <Border Style="{StaticResource HeroPhoto}" Canvas.Left="38" Canvas.Top="14">
                                    <Border.RenderTransform><RotateTransform Angle="-5" /></Border.RenderTransform>
                                    <Grid><Rectangle Style="{StaticResource HeroSky}" /><Path Style="{StaticResource HeroHill}" /><Ellipse Style="{StaticResource HeroSun}" /></Grid>
                                </Border>
                                <Border Style="{StaticResource HeroPhoto}" Canvas.Left="74" Canvas.Top="8">
                                    <Border.RenderTransform><RotateTransform Angle="5" /></Border.RenderTransform>
                                    <Grid><Rectangle Style="{StaticResource HeroSky}" /><Path Style="{StaticResource HeroHill}" /><Ellipse Style="{StaticResource HeroSun}" /></Grid>
                                </Border>
                                <Border Style="{StaticResource HeroPhoto}" Canvas.Left="110" Canvas.Top="26">
                                    <Border.RenderTransform><RotateTransform Angle="14" /></Border.RenderTransform>
                                    <Grid><Rectangle Style="{StaticResource HeroSky}" /><Path Style="{StaticResource HeroHill}" /><Ellipse Style="{StaticResource HeroSun}" /></Grid>
                                </Border>
                            </Canvas>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="FolderHeadline" Style="{StaticResource PhotoSift.PageTitle}"
                                           Text="Find duplicate and look-alike photos" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource PhotoSift.MutedText}" FontSize="14"
                                           Text="Pick one folder on this PC. PhotoSift shows the copies, and you choose what goes to the Recycle Bin." />
                            </StackPanel>
                        </Grid>

                        <!-- The folder card: name and path, one status strip, two switches, Scan. -->
                        <Border x:Name="FolderCard" Margin="0,18,0,0" Style="{StaticResource PhotoSift.Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Margin="0,0,14,0" CornerRadius="10" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource PhotoSift.AccentSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <!-- A folder, as geometry: no font glyph, nothing to fall back to. -->
                                        <Path Width="20" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stretch="Uniform"
                                              Data="M 0,2 Q 0,0 2,0 L 7,0 L 9,2 L 18,2 Q 20,2 20,4 L 20,14 Q 20,16 18,16 L 2,16 Q 0,16 0,14 Z M 0,5 L 20,5 L 20,6 L 0,6 Z">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="{StaticResource PhotoSift.AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="FolderNameText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   AutomationProperties.Name="Folder name"
                                                   Text="{Binding FolderName}" />
                                        <!-- The path as the name's caption; hidden until a folder is chosen. -->
                                        <TextBox x:Name="SelectedPathTextBox"
                                                 FontSize="12"
                                                 IsReadOnly="True"
                                                 Text="{Binding SelectedPath, Mode=OneWay}"
                                                 TextWrapping="Wrap"
                                                 AutomationProperties.Name="Selected folder">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource PhotoSift.PathText}">
                                                    <Setter Property="Foreground" Value="{StaticResource PhotoSift.MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedPath}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                    <Button x:Name="ChooseAnotherScopeButton"
                                            Grid.Column="2"
                                            MinWidth="140"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                            Command="{Binding ChooseScopeCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PhotoSift.Button}">
                                                <Setter Property="Content" Value="Choose folder" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                                        <Setter Property="Content" Value="Change folder" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                        <Setter Property="Content" Value="Change folder" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="Content" Value="Change folder" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                                        <Setter Property="Content" Value="Change folder" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- One strip, coloured by state, one sentence. -->
                                <Border x:Name="FolderStatusStrip" Margin="0,14,0,0" Padding="12,9" CornerRadius="8" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource PhotoSift.SubtleFillBrush}" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PhotoSift.SuccessSoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PhotoSift.WarningSoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PhotoSift.WarningSoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="ScopeStatusIcon"
                                              Width="16"
                                              Height="16"
                                              Margin="0,1,10,0"
                                              VerticalAlignment="Top"
                                              AutomationProperties.ItemStatus="{Binding ScopeStatus}"
                                              AutomationProperties.Name="{Binding ScopeStatus, StringFormat='Folder status: {0}'}"
                                              Fill="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                              Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <!-- An "i" in a circle until the folder is checked. -->
                                                    <Setter Property="Data"
                                                            Value="M 9,0 A 9,9 0 1 0 9,18 A 9,9 0 1 0 9,0 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 8,8 L 10,8 L 10,14 L 8,14 Z" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                            <Setter Property="Data"
                                                                    Value="M 1,9 L 6,14 L 17,3 L 14,0 L 6,8 L 4,6 Z" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                            <Setter Property="Data"
                                                                    Value="M 9,0 L 18,18 L 0,18 Z M 8,5 L 10,5 L 10,12 L 8,12 Z M 8,14 L 10,14 L 10,16 L 8,16 Z" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                                            <Setter Property="Data"
                                                                    Value="M 9,0 L 18,18 L 0,18 Z M 8,5 L 10,5 L 10,12 L 8,12 Z M 8,14 L 10,14 L 10,16 L 8,16 Z" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock x:Name="ScopeStatusText"
                                                   Grid.Column="1"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.HelpText="{Binding Instruction}"
                                                   AutomationProperties.ItemStatus="{Binding FolderStatusSentence}"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.Name="Folder status"
                                                   Text="{Binding FolderStatusSentence}" />
                                    </Grid>
                                </Border>

                                <Border x:Name="BlockingNotice"
                                        Margin="0,10,0,0"
                                        Padding="14"
                                        CornerRadius="10"
                                        Focusable="True"
                                        FocusVisualStyle="{StaticResource PhotoSift.FocusVisual}"
                                        AutomationProperties.Name="{Binding BlockingNoticeAutomationName}"
                                        BorderThickness="1"
                                        Visibility="{Binding IsBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource PhotoSift.WarningSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PhotoSift.WarningBorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="This folder cannot be used yet." />
                                        <ItemsControl Margin="0,6,0,0"
                                                      AutomationProperties.Name="Blocking reasons"
                                                      ItemsSource="{Binding BlockingReasons}" />
                                    </StackPanel>
                                </Border>

                                <Border Height="1" Margin="0,16" Background="{StaticResource PhotoSift.BorderBrush}" />

                                <app:CommandSwitchCheckBox x:Name="IncludeSubfoldersCheckBox"
                                          Style="{StaticResource PhotoSift.SwitchCheckBox}"
                                          AutomationProperties.Name="Include subfolders"
                                          AutomationProperties.HelpText="{Binding SubfoldersCaption}"
                                          Command="{Binding ChangeRecursionCommand}"
                                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                          Content="Include subfolders"
                                          IsEnabled="{Binding CanChangeRecursion}"
                                          IsChecked="{Binding IncludeSubfolders, Mode=OneWay}" />
                                <TextBlock x:Name="IncludeSubfoldersCaption" Margin="56,3,0,0"
                                           Style="{StaticResource PhotoSift.MutedText}"
                                           Text="{Binding SubfoldersCaption}" />

                                <app:CommandSwitchCheckBox x:Name="NearDuplicatesCheckBox"
                                          Margin="0,14,0,0"
                                          Style="{StaticResource PhotoSift.SwitchCheckBox}"
                                          Content="Look-alikes"
                                          IsChecked="{Binding NearDuplicatesEnabled, Mode=OneWay}"
                                          IsEnabled="{Binding CanChangeScanOptions}"
                                          Command="{Binding ChangeNearDuplicateModeCommand}"
                                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                          AutomationProperties.Name="Look-alikes"
                                          AutomationProperties.HelpText="Finds a resized or re-saved copy of the same photo with one careful, fixed setting. Close calls are shown as Maybe similar." />
                                <TextBlock x:Name="NearDuplicatesCaption" Margin="56,3,0,0"
                                           Style="{StaticResource PhotoSift.MutedText}"
                                           Text="Bursts and near-identical shots. Identical copies are always found." />

                                <!-- A live region, shown only when it has something to say. -->
                                <TextBlock x:Name="ScanOptionsGuidanceText"
                                           Margin="0,14,0,0"
                                           Style="{StaticResource PhotoSift.MutedText}"
                                           Text="{Binding ScanOptionsGuidance}"
                                           Visibility="{Binding HasScanOptionsGuidance, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           AutomationProperties.Name="Scan options guidance"
                                           AutomationProperties.ItemStatus="{Binding ScanOptionsGuidance}"
                                           AutomationProperties.LiveSetting="Polite" />

                                <Expander x:Name="FolderDetailsExpander" Margin="0,14,0,0" Header="Details" IsExpanded="False"
                                          AutomationProperties.Name="Folder check details">
                                    <StackPanel Margin="0,10,0,0">
                                        <ItemsControl x:Name="ScopeSummaryList"
                                                      AutomationProperties.Name="Folder check summary"
                                                      Grid.IsSharedSizeScope="True"
                                                      ItemsSource="{Binding ScopeSummary}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PreflightLabel" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource PhotoSift.MutedText}" Text="{Binding Label}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="24,0,0,0"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="RuleSetStatusText"
                                                   Margin="0,6,0,0"
                                                   Style="{StaticResource PhotoSift.MutedText}"
                                                   Text="{Binding RuleSetStatus, StringFormat='Scan options: {0}'}" />
                                        <TextBlock Margin="0,10,0,0" Style="{StaticResource PhotoSift.Caption}" Text="Full path, as Windows resolves it" />
                                        <TextBox x:Name="ResolvedPathTextBox"
                                                 Margin="0,4,0,0"
                                                 Style="{StaticResource PhotoSift.PathText}"
                                                 IsReadOnly="True"
                                                 Text="{Binding ResolvedPath, Mode=OneWay}"
                                                 TextWrapping="Wrap"
                                                 AutomationProperties.Name="Resolved folder path" />
                                    </StackPanel>
                                </Expander>

                                <Border Height="1" Margin="0,16" Background="{StaticResource PhotoSift.BorderBrush}" />

                                <!-- The card's footer: the one next step. -->
                                <WrapPanel>
                                    <Button x:Name="ScanFolderButton" Margin="0,0,10,0" MinWidth="160"
                                            Style="{StaticResource PhotoSift.LargePrimaryButton}"
                                            Content="{Binding ScanFolderText}"
                                            AutomationProperties.Name="{Binding ScanFolderText}"
                                            AutomationProperties.HelpText="Confirms the options above for this folder and starts reading the photos. Nothing is changed or moved."
                                            Command="{Binding ScanFolderCommand}" IsEnabled="{Binding CanScanFolder}" />
                                    <Button x:Name="RetryScopeButton"
                                            MinWidth="140"
                                            AutomationProperties.Name="Check the folder again"
                                            Command="{Binding RetryScopeCommand}"
                                            Content="Check again">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PhotoSift.Button}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="MinHeight" Value="44" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Three promises, under the card. -->
                        <StackPanel x:Name="TrustLines" Margin="4,16,0,0" AutomationProperties.Name="What PhotoSift promises">
                            <StackPanel.Resources>
                                <Style x:Key="TrustIcon" TargetType="Path">
                                    <Setter Property="Width" Value="14" />
                                    <Setter Property="Height" Value="14" />
                                    <Setter Property="Margin" Value="0,2,10,0" />
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                    <Setter Property="Stretch" Value="Uniform" />
                                    <Setter Property="Fill" Value="{StaticResource PhotoSift.SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <Style x:Key="TrustText" TargetType="TextBlock" BasedOn="{StaticResource PhotoSift.MutedText}">
                                    <Setter Property="FontSize" Value="13" />
                                </Style>
                            </StackPanel.Resources>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <!-- A padlock. -->
                                <Path Style="{StaticResource TrustIcon}"
                                      Data="M 5,8 L 5,5 A 4,4 0 0 1 13,5 L 13,8 L 15,8 L 15,17 L 3,17 L 3,8 Z M 7,8 L 11,8 L 11,5 A 2,2 0 0 0 7,5 Z" />
                                <TextBlock Style="{StaticResource TrustText}" Text="Stays on this PC. No account, no upload." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <!-- A bin with a lid. -->
                                <Path Style="{StaticResource TrustIcon}"
                                      Data="M 6,1 L 12,1 L 12,3 L 17,3 L 17,5 L 1,5 L 1,3 L 6,3 Z M 3,7 L 15,7 L 14,17 L 4,17 Z" />
                                <TextBlock Style="{StaticResource TrustText}" Text="Recycle Bin only. Nothing is deleted for good." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!-- A check mark. -->
                                <Path Style="{StaticResource TrustIcon}"
                                      Data="M 1,9 L 6,14 L 17,3 L 14,0 L 6,8 L 4,6 Z" />
                                <TextBlock Style="{StaticResource TrustText}" Text="You decide. At least one photo of every set is kept." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="2" Visibility="{Binding IsScanPhase, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,4,20,8" MaxWidth="760" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource PhotoSift.PageTitle}" Text="Scan" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource PhotoSift.MutedText}"
                                   Text="PhotoSift is only reading your photos. You can cancel at any time." />

                        <Border Margin="0,18,0,0" Style="{StaticResource PhotoSift.Card}">
                            <StackPanel>
                                <TextBlock x:Name="ScanStatusText" Text="{Binding ScanStatus}"
                                           Style="{StaticResource PhotoSift.SectionTitle}" FontSize="18"
                                           AutomationProperties.Name="Scan status" AutomationProperties.ItemStatus="{Binding ScanStatus}"
                                           AutomationProperties.LiveSetting="Polite" />
                                <ProgressBar Height="8" Margin="0,14,0,0" IsIndeterminate="{Binding IsScanBusy}"
                                             Foreground="{StaticResource PhotoSift.AccentBrush}"
                                             AutomationProperties.Name="Scan activity"
                                             AutomationProperties.ItemStatus="{Binding ScanStatus}" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource PhotoSift.MutedText}" Text="{Binding ScanCountsText}" />

                                <Border Height="1" Margin="0,16" Background="{StaticResource PhotoSift.BorderBrush}" />

                                <ItemsControl ItemsSource="{Binding ScanOutcomeSummaries}"
                                              ItemTemplate="{StaticResource ScanOutcomeSummaryTemplate}"
                                              AutomationProperties.Name="Scan outcome categories" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource PhotoSift.MutedText}" Text="{Binding CoverageStatus}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- The main actions stay in view while the details above scroll. -->
                <WrapPanel Grid.Row="1" Margin="4,12,20,0" MaxWidth="760" HorizontalAlignment="Stretch">
                    <Button Content="Open Review" Margin="0,0,10,10" MinWidth="160" AutomationProperties.Name="Open Review"
                            Style="{StaticResource PhotoSift.LargePrimaryButton}"
                            Command="{Binding OpenReviewCommand}" IsEnabled="{Binding CanOpenReview}" />
                    <Button x:Name="CancelScanButton" Content="Cancel Scan" Margin="0,0,10,10" MinHeight="44"
                            Style="{StaticResource PhotoSift.Button}"
                            AutomationProperties.Name="Cancel Scan" Command="{Binding CancelScanCommand}" IsEnabled="{Binding IsScanBusy}" />
                    <Button Content="Scan again" Margin="0,0,10,10" MinHeight="44" AutomationProperties.Name="Start a fresh scan"
                            Style="{StaticResource PhotoSift.Button}"
                            Command="{Binding StartScanCommand}" IsEnabled="{Binding CanStartScan}" />
                </WrapPanel>
            </Grid>

            <!-- The Review page scrolls as one surface so the viewer, selection and approval stay
                 reachable at any window size. Each review level still owns a native virtualized
                 viewport: ReviewNavigationGrid gets a bounded height from the page viewport. The
                 selection bar under the page stays put while the page scrolls. -->
            <Grid Grid.Column="2" Visibility="{Binding IsReviewPhase, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <ScrollViewer x:Name="ReviewPageScrollViewer"
                          Visibility="{Binding IsReviewPhase, Converter={StaticResource BooleanToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="OnReviewPageSizeChanged">
              <StackPanel Margin="4,4,20,8">
                <StackPanel>
                    <TextBlock x:Name="ReviewHeading" Text="Review" Style="{StaticResource PhotoSift.PageTitle}" Focusable="True"
                               FocusVisualStyle="{StaticResource PhotoSift.FocusVisual}"
                               AutomationProperties.Name="Grouped duplicate review" />
                    <TextBlock x:Name="ReviewResultsSummaryText" Margin="0,4,0,0" Style="{StaticResource PhotoSift.SectionTitle}"
                               Text="{Binding ReviewResultsSummary}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource PhotoSift.MutedText}"
                               Text="Pick a kind, open a set and choose Keep or Remove for each photo. Nothing changes until you approve the cleanup below." />
                    <TextBlock x:Name="ReviewStatusText" Margin="0,6,0,0" Text="{Binding ReviewStatusText}" TextWrapping="Wrap"
                               AutomationProperties.Name="Review status" AutomationProperties.ItemStatus="{Binding ReviewStatusText}"
                               AutomationProperties.LiveSetting="Polite" />
                    <!-- What a review continued after a cleanup leaves out (PM-013). -->
                    <TextBlock x:Name="ReviewContinuationText" Margin="0,6,0,0" Text="{Binding ReviewContinuationText}" TextWrapping="Wrap"
                               Style="{StaticResource PhotoSift.MutedText}"
                               Visibility="{Binding HasReviewContinuation, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.Name="Review continuation" />
                    <DockPanel Margin="0,8,0,4">
                        <Button x:Name="ReviewBackButton" Content="Back" MinHeight="34" Padding="14,4" Margin="0,0,10,0"
                                Style="{StaticResource PhotoSift.Button}"
                                Click="OnReviewBackClick" IsEnabled="{Binding CanReviewBack}"
                                AutomationProperties.Name="Back one review level" />
                        <TextBlock x:Name="ReviewBreadcrumbText" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding ReviewBreadcrumbText}" AutomationProperties.Name="Review breadcrumb" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource PhotoSift.MutedText}" Text="{Binding CoverageStatus}" />
                    <Expander x:Name="ReviewScanSummaryExpander" Header="Scan summary" IsExpanded="False" Margin="0,2,0,0"
                              AutomationProperties.Name="Scan summary">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding ScanCountsText}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding ScanOutcomeSummaries}"
                                          ItemTemplate="{StaticResource ScanOutcomeSummaryTemplate}"
                                          AutomationProperties.Name="Scan outcome categories" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <Grid x:Name="ReviewNavigationGrid" Height="300" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ReviewCategoriesColumn" Width="*" />
                        <ColumnDefinition x:Name="ReviewGroupsColumn" Width="*" />
                        <ColumnDefinition x:Name="ReviewComparisonsColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ReviewCategoriesPanel" Grid.Column="0" Margin="0,0,4,0" Padding="6" CornerRadius="12"
                            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                            BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="What was found" Style="{StaticResource PhotoSift.SectionTitle}" Margin="6,4,6,6" />
                            <ListBox x:Name="ReviewCategoriesList" PreviewMouseWheel="OnReviewListPreviewMouseWheel" ItemsSource="{Binding ReviewCategories}"
                                     Style="{StaticResource ReviewListStyle}" ItemTemplate="{StaticResource ReviewCategoryTemplate}"
                                     PreviewKeyDown="OnReviewListPreviewKeyDown"
                                     AutomationProperties.Name="Review categories" />
                        </DockPanel>
                    </Border>
                    <Border x:Name="ReviewGroupsPanel" Grid.Column="1" Margin="4,0" Padding="6" CornerRadius="12"
                            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                            BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Sets" Style="{StaticResource PhotoSift.SectionTitle}" Margin="6,4,6,6" />
                            <ListBox x:Name="ReviewGroupsList" PreviewMouseWheel="OnReviewListPreviewMouseWheel" ItemsSource="{Binding ActiveReviewGroups}"
                                     Style="{StaticResource ReviewListStyle}" ItemTemplate="{StaticResource ReviewGroupTemplate}"
                                     PreviewKeyDown="OnReviewListPreviewKeyDown"
                                     AutomationProperties.Name="Groups in selected category" />
                        </DockPanel>
                    </Border>
                    <Border x:Name="ReviewComparisonsPanel" Grid.Column="2" Margin="4,0,0,0" Padding="6" CornerRadius="12"
                            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                            BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Photos in this set" Style="{StaticResource PhotoSift.SectionTitle}" Margin="6,4,6,6" />
                            <ListBox x:Name="ReviewComparisonsList" PreviewMouseWheel="OnReviewListPreviewMouseWheel" ItemsSource="{Binding ActiveReviewMembers}"
                                     Style="{StaticResource ReviewListStyle}" ItemTemplate="{StaticResource ReviewComparisonTemplate}"
                                     PreviewKeyDown="OnReviewListPreviewKeyDown"
                                     AutomationProperties.Name="Comparison paths and Selection controls" />
                        </DockPanel>
                    </Border>
                </Grid>

                  <StackPanel x:Name="ReviewDetailsPanel" Margin="0,10,0,0">
                <!-- Viewer: the open photo large, Previous / Next through the set, and an
                     optional second photo side by side with one zoom for both. -->
                <app:ReviewAutomationBorder x:Name="ReviewEvidencePanel" Padding="14" CornerRadius="12"
                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        AutomationProperties.AutomationId="review-evidence"
                        AutomationProperties.Name="{Binding ActiveReviewEvidence.AutomationName}"
                        AutomationProperties.ItemStatus="{Binding ActiveReviewEvidence.ItemStatus}">
                    <StackPanel DataContext="{Binding ActiveReviewEvidence}">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Viewer"
                                       Style="{StaticResource PhotoSift.SectionTitle}" />
                            <WrapPanel DockPanel.Dock="Right"
                                       DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button x:Name="PreviousPhotoButton" Content="Previous" Margin="0,0,6,4" MinHeight="32" Padding="12,4"
                                        Style="{StaticResource PhotoSift.Button}"
                                        Command="{Binding ShowPreviousReviewMemberCommand}"
                                        AutomationProperties.Name="Previous photo in this set" />
                                <Button x:Name="NextPhotoButton" Content="Next" Margin="0,0,12,4" MinHeight="32" Padding="12,4"
                                        Style="{StaticResource PhotoSift.Button}"
                                        Command="{Binding ShowNextReviewMemberCommand}"
                                        AutomationProperties.Name="Next photo in this set" />
                                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <Slider x:Name="ReviewZoomSlider" Width="120" Minimum="1" Maximum="4" Value="1"
                                        SmallChange="0.25" LargeChange="0.5" VerticalAlignment="Center" Margin="0,0,12,4"
                                        AutomationProperties.Name="Zoom for the photos in the viewer" />
                                <Button x:Name="CloseCompareButton" Content="Close compare" Margin="0,0,0,4" MinHeight="32" Padding="12,4"
                                        Style="{StaticResource PhotoSift.Button}"
                                        Command="{Binding CloseCompareCommand}"
                                        Visibility="{Binding IsComparingReviewMembers, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.Name="Close side-by-side compare" />
                            </WrapPanel>
                        </DockPanel>
                        <UniformGrid Rows="1" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource PhotoSift.Caption}" Margin="0,0,0,4"
                                           Text="{Binding DataContext.ActiveReviewMember.FileName, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <app:PreviewStatusControl x:Name="ReviewPreviewStatusControl"
                                        Zoom="{Binding Value, ElementName=ReviewZoomSlider}"
                                        DataContext="{Binding DataContext.ActiveReviewPreview, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0"
                                        Visibility="{Binding DataContext.IsComparingReviewMembers, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource PhotoSift.Caption}" Margin="0,0,0,4"
                                           Text="{Binding DataContext.ComparedReviewMember.FileName, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Compared with {0}'}" />
                                <!-- The second preview exists only while comparing. -->
                                <ContentControl x:Name="ComparedPreviewHost" Focusable="False"
                                                Content="{Binding DataContext.ComparedReviewPreview, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type shell:PreviewItemViewModel}">
                                            <app:PreviewStatusControl Loaded="OnComparedPreviewLoaded" />
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock x:Name="ReviewEvidenceFullPathText" Text="{Binding FullPath}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReviewEvidenceDimensionsText" Text="{Binding Dimensions, StringFormat='Dimensions: {0}'}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReviewEvidenceSizeText" Text="{Binding Size, StringFormat='Size: {0}'}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReviewEvidenceRelevantDateText" Text="{Binding RelevantDate, StringFormat='Relevant date: {0}'}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReviewEvidenceCategoryText" Text="{Binding Category, StringFormat='Kind: {0}'}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReviewEvidenceConfidenceText" Text="{Binding Confidence, StringFormat='Confidence: {0}'}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReviewEvidenceUncertaintyText" Text="{Binding Uncertainty, StringFormat='Uncertainty: {0}'}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReviewEvidenceTransformationsText" Text="{Binding Transformations, StringFormat='Transformations: {0}'}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReviewEvidenceReasonText" Text="{Binding Reason, StringFormat='Reason: {0}'}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReviewEvidenceRecommendationText" Text="{Binding Recommendation}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </app:ReviewAutomationBorder>

                <TextBlock x:Name="SelectionSummaryText" Text="{Binding SelectionSummary}" TextWrapping="Wrap" Margin="0,10,0,0"
                           AutomationProperties.Name="Selection summary"
                           AutomationProperties.ItemStatus="{Binding SelectionSummary}"
                           AutomationProperties.LiveSetting="Polite" />

                    <app:ReviewAutomationBorder x:Name="ApprovalPanel" Margin="0,8,0,0" Padding="16" Focusable="True" CornerRadius="12"
                            FocusVisualStyle="{StaticResource PhotoSift.FocusVisual}"
                            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                            BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            AutomationProperties.AutomationId="approval-panel"
                            AutomationProperties.Name="Cleanup approval disclosure"
                            AutomationProperties.ItemStatus="{Binding ApprovalAutomationStatus}">
                        <StackPanel>
                            <TextBlock x:Name="ApprovalTitleText" Text="{Binding ApprovalTitle}" FontSize="20"
                                       Style="{StaticResource PhotoSift.SectionTitle}" />
                            <TextBlock Margin="0,4,0,10" Style="{StaticResource PhotoSift.MutedText}"
                                       Text="Nothing changes until you approve. Marked photos go to the Windows Recycle Bin only, and each file is checked again right before it moves." />
                            <!-- The first marked photos, so the approval names what it moves. -->
                            <ItemsControl x:Name="ApprovalMarkedPhotosList" ItemsSource="{Binding ApprovalMarkedPhotos}" Focusable="False"
                                          AutomationProperties.Name="Photos marked for removal">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="64" Height="48" CornerRadius="6" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PhotoSift.SubtleFillBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <app:PhotoThumbnail Member="{Binding}" CornerRadius="6"
                                                        Loader="{Binding DataContext.ReviewThumbnails, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBox Text="{Binding DiscoveredPath, Mode=OneWay}" IsTabStop="False" FontSize="12"
                                                         Style="{StaticResource PhotoSift.PathText}"
                                                         AutomationProperties.Name="{Binding DiscoveredPath}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="76,0,0,8" Style="{StaticResource PhotoSift.MutedText}" Text="{Binding ApprovalMoreMarkedText}"
                                       Visibility="{Binding HasMoreMarkedPhotos, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button x:Name="ApproveCleanupButton" Content="Move to Recycle Bin" MinHeight="40"
                                    Margin="0,4,0,0" Padding="20,8" HorizontalAlignment="Left"
                                    Style="{StaticResource PhotoSift.PrimaryButton}"
                                    IsDefault="False" IsCancel="False" AutomationProperties.Name="Move the marked photos to the Recycle Bin"
                                    Command="{Binding ApproveReviewCommand}" IsEnabled="{Binding CanApproveReview}" />
                            <!-- The full accounting the approval covers, kept on screen as the record of it. -->
                            <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="What this covers" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding ApprovalSelectedOccurrenceText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ApprovalSelectedPathText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ApprovalSelectedPhysicalText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ApprovalRecoveryText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ApprovalCoverageText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ApprovalUnresolvedText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ApprovalUnresolvedSubtotals}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ApprovalUnselectedSurvivorsText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ApprovalDestinationText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ApprovalRevalidationText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource PhotoSift.SubtleFillBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource PhotoSift.MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                    </app:ReviewAutomationBorder>
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource PhotoSift.MutedText}" Text="{Binding ReviewDisclaimer}" />
                    <WrapPanel>
                        <Button Content="Cancel Scan" Padding="12,6" Margin="0,6,8,0" AutomationProperties.Name="Cancel Scan from Review"
                                Style="{StaticResource PhotoSift.Button}"
                                Command="{Binding CancelScanCommand}" IsEnabled="{Binding IsScanBusy}" />
                        <Button Content="Scan again" Padding="12,6" Margin="0,6,8,0" AutomationProperties.Name="Start a fresh scan from Review"
                                Style="{StaticResource PhotoSift.Button}"
                                Command="{Binding StartScanCommand}" IsEnabled="{Binding CanStartScan}" />
                    </WrapPanel>
                </StackPanel>
                  </StackPanel>
              </StackPanel>
            </ScrollViewer>
                <!-- Sticky selection bar: what is marked, and a way to the approval panel. -->
                <Border x:Name="ReviewSelectionBar" Grid.Row="1" Margin="4,8,20,0" Padding="14,8" CornerRadius="12"
                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                    <DockPanel>
                        <Button x:Name="ReviewCleanupButton" DockPanel.Dock="Right" Content="Review cleanup" MinHeight="34" Padding="14,4"
                                Margin="10,0,0,0" Style="{StaticResource PhotoSift.Button}"
                                Click="OnReviewCleanupClick"
                                ToolTip="Go to the cleanup approval"
                                AutomationProperties.Name="Go to the cleanup approval" />
                        <TextBlock x:Name="ReviewSelectionBarText" VerticalAlignment="Center" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding ReviewSelectionBarText}" ToolTip="{Binding ReviewSelectionBarText}" />
                    </DockPanel>
                </Border>
            </Grid>
            <app:ReviewAutomationBorder x:Name="ActionPanel" Grid.Column="2"
                    Visibility="{Binding IsActionPhase, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.AutomationId="action-panel"
                    AutomationProperties.Name="Recycle Bin cleanup"
                    AutomationProperties.ItemStatus="{Binding ActionStatusText}">
                <!-- Like Review, the Action page scrolls as one surface; the item list keeps a
                     bounded height from the page viewport so it stays virtualized. -->
                <ScrollViewer x:Name="ActionPageScrollViewer"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              SizeChanged="OnActionPageSizeChanged">
                <StackPanel Margin="4,4,20,0" MaxWidth="960" HorizontalAlignment="Left">
                    <TextBlock x:Name="ActionHeading" Text="{Binding ActionHeadline}" Style="{StaticResource PhotoSift.PageTitle}"
                               Focusable="True" FocusVisualStyle="{StaticResource ActionFocusVisual}"
                               AutomationProperties.Name="{Binding ActionHeadline}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource PhotoSift.MutedText}"
                               Text="Photos go to the Windows Recycle Bin one at a time. Each one is checked again right before it moves, and nothing is retried on its own." />
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding HasActionItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar x:Name="ActionProgressBar" Height="8" Minimum="0"
                                     Maximum="{Binding ActionTotalCount, Mode=OneWay}" Value="{Binding ActionDoneCount, Mode=OneWay}"
                                     AutomationProperties.Name="Cleanup progress"
                                     AutomationProperties.ItemStatus="{Binding ActionProgressText}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="{StaticResource PhotoSift.AccentBrush}" />
                                    <Setter Property="Background" Value="{StaticResource PhotoSift.SubtleFillBrush}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding ActionProgressText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border x:Name="ActionOutcomeBanner" Margin="0,12,0,0" Style="{StaticResource PhotoSift.ToneBanner}"
                            Tag="{Binding ActionOutcomeTone}"
                            Visibility="{Binding HasActionOutcome, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ActionOutcomeText}" TextWrapping="Wrap" />
                    </Border>
                    <!-- A finished cleanup is not the end of the session: keep reviewing the
                         same scan without the removed photos, or start over. -->
                    <StackPanel x:Name="ActionNextStepsPanel" Margin="0,12,0,0"
                                Visibility="{Binding HasActionOutcome, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock x:Name="ContinueReviewHintText" Text="{Binding ContinueReviewHint}" TextWrapping="Wrap"
                                   Style="{StaticResource PhotoSift.MutedText}"
                                   Visibility="{Binding HasContinueReviewHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <WrapPanel Margin="0,4,0,0">
                            <Button x:Name="ContinueReviewButton" Content="Continue reviewing" MinHeight="44" MinWidth="180" Margin="0,4,10,0"
                                    Style="{StaticResource PhotoSift.LargePrimaryButton}"
                                    AutomationProperties.Name="Continue reviewing the remaining sets"
                                    Command="{Binding ContinueReviewCommand}" IsEnabled="{Binding CanContinueReview}" />
                            <Button x:Name="ActionScanAgainButton" Content="Scan again" MinHeight="44" Margin="0,4,10,0" Padding="12,6"
                                    Style="{StaticResource PhotoSift.Button}"
                                    AutomationProperties.Name="Start a fresh scan from the cleanup"
                                    Command="{Binding StartScanCommand}" IsEnabled="{Binding CanStartScan}" />
                        </WrapPanel>
                    </StackPanel>
                    <ListBox x:Name="ActionItemsList" Margin="0,10,0,0" Height="300" PreviewMouseWheel="OnReviewListPreviewMouseWheel" ItemsSource="{Binding ActionRows}"
                             Style="{StaticResource ReviewListStyle}" ItemTemplate="{StaticResource ActionItemTemplate}"
                             AutomationProperties.Name="Photos in this cleanup and what happened to each"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                      <StackPanel x:Name="ActionNoticesPanel" Margin="0,12,0,0">
                        <!-- The recorded detail behind the summary above. -->
                        <Border Padding="12,10" CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource PhotoSift.SubtleFillBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource PhotoSift.MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Cleanup record" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ActionSelectionText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ActionStatusText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ActionCountsText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ActionCertaintyText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ActionReplayNotice}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ActionRecoveryNotice}" TextWrapping="Wrap" />
                                <app:ReviewAnnouncementTextBlock x:Name="ActionAnnouncementText" Text="{Binding ActionAnnouncement}"
                                        Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="action-announcement"
                                        AutomationProperties.Name="Recycle Bin progress announcement"
                                        AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Earlier cleanups" Margin="0,18,0,0" Style="{StaticResource PhotoSift.SectionTitle}"
                                   Visibility="{Binding HasActionRecoveryRecords, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border Margin="0,8,0,0" Style="{StaticResource PhotoSift.ToneBanner}" Tag="Warning"
                                Visibility="{Binding HasActionRecoveryDisclosure, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ActionRecoveryDisclosure}" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="action-recovery-disclosure" />
                                <Button x:Name="RevalidateUnknownItemsButton" Content="Revalidate unknown items"
                                        MinHeight="36" Margin="0,8,0,0" Padding="14,6" HorizontalAlignment="Left"
                                        Style="{StaticResource PhotoSift.Button}"
                                        AutomationProperties.Name="Revalidate unknown items"
                                        Command="{Binding RevalidateUnknownCommand}"
                                        IsEnabled="{Binding CanRevalidateUnknownItems}" />
                            </StackPanel>
                        </Border>
                        <app:ReviewAnnouncementTextBlock x:Name="ActionRecoveryAnnouncementText"
                                Text="{Binding ActionRecoveryAnnouncement}" TextWrapping="Wrap" Margin="0,6,0,0"
                                AutomationProperties.AutomationId="action-recovery-announcement"
                                AutomationProperties.Name="Action record status announcement"
                                AutomationProperties.LiveSetting="Polite" />
                        <ItemsControl ItemsSource="{Binding ActionRecoveryRecords}"
                                      ItemTemplate="{StaticResource ActionRecordHistoryTemplate}"
                                      Visibility="{Binding HasActionRecoveryRecords, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </app:ReviewAutomationBorder>
        </Grid>
          </TabItem>
          <TabItem x:Name="ActionRecordsTab" Header="History" Selector.Unselected="OnHistoryUnselected"
                   AutomationProperties.Name="History">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="4,4,20,12" MaxWidth="960" HorizontalAlignment="Left">
                <TextBlock Text="History" Style="{StaticResource PhotoSift.PageTitle}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource PhotoSift.MutedText}"
                           Text="Every cleanup saved on this PC: what moved to the Recycle Bin, what was skipped, and why. A cleanup you run now is listed on its own screen and appears here the next time PhotoSift starts." />
                <Border Margin="0,14,0,0" Style="{StaticResource PhotoSift.ToneBanner}" Tag="Warning"
                        Visibility="{Binding HasActionRecoveryDisclosure, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ActionRecoveryDisclosure}" TextWrapping="Wrap" />
                        <Button x:Name="HistoryRevalidateUnknownItemsButton" Content="Revalidate unknown items"
                                MinHeight="36" Margin="0,8,0,0" Padding="14,6" HorizontalAlignment="Left"
                                Style="{StaticResource PhotoSift.Button}"
                                AutomationProperties.Name="Revalidate unknown items"
                                Command="{Binding RevalidateUnknownCommand}"
                                IsEnabled="{Binding CanRevalidateUnknownItems}" />
                    </StackPanel>
                </Border>
                <app:ReviewAnnouncementTextBlock Text="{Binding ActionRecoveryAnnouncement}" Margin="0,8,0,0"
                        Style="{StaticResource PhotoSift.MutedText}" AutomationProperties.LiveSetting="Polite" />
                <Border Margin="0,8,0,12" Style="{StaticResource PhotoSift.Card}" Padding="18,14"
                        Visibility="{Binding HasNoActionRecords, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource PhotoSift.MutedText}"
                               Text="No saved cleanups yet. Each cleanup is recorded here once PhotoSift restarts after it." />
                </Border>
                <ItemsControl x:Name="ActionRecordsHistoryList" Margin="0,8,0,0" Focusable="False"
                              ItemsSource="{Binding ActionRecoveryRecords}"
                              ItemTemplate="{StaticResource ActionRecordHistoryTemplate}" />
                <!-- Local scan data lives with the history it does not touch. -->
                <Border Margin="0,12,0,0" Style="{StaticResource PhotoSift.Card}" Padding="18,14"
                        Visibility="{Binding HasLocalScanDataControl, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Scan data on this PC" Style="{StaticResource PhotoSift.SectionTitle}" />
                        <TextBlock Margin="0,2,0,8" Style="{StaticResource PhotoSift.MutedText}"
                                   Text="PhotoSift keeps scan results and checkpoints so a scan can pick up where it stopped. Clearing them does not touch your photos or this history." />
                        <Button x:Name="ClearScanDataButton"
                                Style="{StaticResource PhotoSift.Button}"
                                Content="Clear scan data"
                                HorizontalAlignment="Left"
                                MinHeight="34"
                                Padding="12,6"
                                IsDefault="False"
                                IsCancel="False"
                                AutomationProperties.Name="Clear local Scan data"
                                AutomationProperties.HelpText="Starts confirmation. Source photos and Action records are not cleared."
                                Command="{Binding RequestClearScanDataCommand}" />
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding IsClearScanDataConfirmationPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock x:Name="ClearScanDataConsequenceText"
                                       Text="This clears saved scan results and checkpoints. Source photos are unchanged. Action records are retained, so this history stays."
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="ConfirmClearScanDataButton"
                                        Content="Clear scan data now"
                                        MinHeight="34"
                                        Padding="12,6"
                                        Margin="0,0,8,0"
                                        IsDefault="False"
                                        IsCancel="False"
                                        IsTabStop="True"
                                        Style="{StaticResource DangerButtonStyle}"
                                        AutomationProperties.Name="Confirm clear local Scan data"
                                        AutomationProperties.HelpText="Clears local Scan data. Source photos and Action records remain unchanged."
                                        IsVisibleChanged="OnClearScanDataConfirmationVisibilityChanged"
                                        Command="{Binding ConfirmClearScanDataCommand}" />
                                <Button Content="Cancel"
                                        Style="{StaticResource PhotoSift.Button}"
                                        MinHeight="34"
                                        Padding="12,6"
                                        IsDefault="False"
                                        IsCancel="False"
                                        AutomationProperties.Name="Cancel clearing local Scan data"
                                        Command="{Binding CancelClearScanDataCommand}" />
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock x:Name="LocalDataClearStatusText"
                                   Margin="0,6,0,0"
                                   Text="{Binding LocalDataClearStatus}"
                                   TextWrapping="Wrap"
                                   Focusable="True"
                                   AutomationProperties.Name="Local Scan data clear status"
                                   AutomationProperties.ItemStatus="{Binding LocalDataClearStatus}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <app:ReviewAnnouncementTextBlock x:Name="ReviewAnnouncementText"
                       Text="{Binding ReviewAnnouncement}" TextWrapping="Wrap"
                       AutomationProperties.Name="Review command status"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="SourceMutationNoticeText"
                       Style="{StaticResource PhotoSift.MutedText}"
                       Text="{Binding SourceMutationNotice}" />
        </StackPanel>
    </Grid>
    </Grid>
</Window>
