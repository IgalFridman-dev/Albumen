<Window x:Class="PhotoSift.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PhotoSift"
        Width="880"
        Height="620"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock FontSize="30"
                       FontWeight="SemiBold"
                       Text="PhotoSift" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="16"
                       Text="A careful, local workflow for reviewing photo cleanup." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,24"
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="PhotoSift works offline. This workflow stays on this PC." />
                <TextBlock Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding Instruction}" />
            </StackPanel>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Phases}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="14"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding DisplayName}" />
                                <TextBlock Margin="0,4,0,0"
                                           Opacity="0.72"
                                           Text="{Binding AvailabilityLabel}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    MinWidth="120"
                                    Padding="16,7"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding DisplayName}"
                                    Command="{Binding DataContext.ChooseScopeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="{Binding DisplayName}"
                                    IsEnabled="{Binding IsAvailable}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="3"
                   Margin="0,16,0,0"
                   Opacity="0.7"
                   Text="No account or network connection is required." />
    </Grid>
</Window>
