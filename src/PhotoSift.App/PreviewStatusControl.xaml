<UserControl x:Class="PhotoSift.App.PreviewStatusControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.Name="{Binding AutomationName}"
        AutomationProperties.ItemStatus="{Binding StatusText}">
    <StackPanel>
        <Image Source="{Binding Image, Mode=OneWay}"
               MaxWidth="512"
               MaxHeight="512"
               Stretch="Uniform"
               AutomationProperties.Name="Active comparison preview" />
        <TextBox x:Name="PreviewFullPathTextBox"
                 Text="{Binding FullPath, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                 Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                 AutomationProperties.Name="Full preview path" />
        <TextBlock x:Name="PreviewStatusText"
                   Text="{Binding StatusText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="{Binding StatusText}"
                   AutomationProperties.ItemStatus="{Binding StatusText}"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
