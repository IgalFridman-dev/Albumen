<Window x:Class="PhotoSift.App.SurvivorOverrideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Final survivor override"
        Width="620"
        Height="420"
        MinWidth="440"
        MinHeight="320"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        AutomationProperties.AutomationId="survivor-override-dialog"
        AutomationProperties.Name="Final survivor override dialog"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing"
        Loaded="OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Confirm final-survivor override"
                   FontSize="24"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" Margin="0,18,0,18"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="OverrideConsequenceText"
                           Focusable="True"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Final survivor consequence. This Selection removes every survivor currently proven by this Scan. Continue only if you deliberately accept that no proven in-Scan copy will remain."
                           Text="This Selection removes every survivor currently proven by this Scan. Continue only if you deliberately accept that no proven in-Scan copy will remain." />
                <TextBlock Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           Text="The affirmation is durable evidence for this exact Review revision. It does not remove files or authorize Action execution." />
                <TextBlock Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding ConsequenceTextVersion, StringFormat='Consequence text version: {0}'}" />
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
            <Button x:Name="CancelSurvivorOverrideButton"
                    MinWidth="120"
                    MinHeight="38"
                    Margin="0,0,10,0"
                    Padding="14,7"
                    IsDefault="False"
                    IsCancel="False"
                    AutomationProperties.Name="Cancel final survivor override"
                    Content="Cancel"
                    Click="OnCancel" />
            <Button x:Name="AffirmFinalSurvivorButton"
                    MinWidth="220"
                    MinHeight="38"
                    Padding="14,7"
                    IsDefault="False"
                    IsCancel="False"
                    AutomationProperties.Name="Affirm final survivor override consequence"
                    Content="I affirm the consequence"
                    Click="OnAffirm" />
        </WrapPanel>
    </Grid>
</Window>
