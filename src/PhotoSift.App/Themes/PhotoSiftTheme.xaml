<!-- PhotoSift visual tokens and control styles. MainWindow merges this dictionary itself
     (tests construct MainWindow without App), so every style here is keyed and opt-in.
     Text and surfaces keep SystemColors brushes so High Contrast still applies; only
     accents, borders and decorative tints are fixed colors. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="PhotoSift.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="PhotoSift.DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="PhotoSift.AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="PhotoSift.AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="PhotoSift.AccentPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="PhotoSift.AccentSoftBrush" Color="#EFF4FF" />
    <SolidColorBrush x:Key="PhotoSift.BorderBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="PhotoSift.BorderStrongBrush" Color="#C4C4CC" />
    <SolidColorBrush x:Key="PhotoSift.HoverBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="PhotoSift.PressedBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="PhotoSift.MutedTextBrush" Color="#52525B" />
    <SolidColorBrush x:Key="PhotoSift.SubtleFillBrush" Color="#EEF0F3" />
    <SolidColorBrush x:Key="PhotoSift.SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="PhotoSift.SuccessSoftBrush" Color="#ECFDF3" />
    <SolidColorBrush x:Key="PhotoSift.WarningSoftBrush" Color="#FFF7ED" />
    <SolidColorBrush x:Key="PhotoSift.WarningBorderBrush" Color="#F5C38B" />
    <SolidColorBrush x:Key="PhotoSift.DangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="PhotoSift.DangerHoverBrush" Color="#912018" />
    <SolidColorBrush x:Key="PhotoSift.DangerSoftBrush" Color="#FEF3F2" />
    <!-- Review kinds: Identical copies (accent), Look-alike (teal), Maybe similar (amber). -->
    <SolidColorBrush x:Key="PhotoSift.LookAlikeBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="PhotoSift.MaybeSimilarBrush" Color="#B45309" />

    <!-- Keyboard focus ring shared by every themed control. -->
    <Style x:Key="PhotoSift.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="10" RadiusY="10" StrokeThickness="2"
                               Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text roles. Muted text falls back to the system text color under High Contrast. -->
    <Style x:Key="PhotoSift.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PhotoSift.DisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PhotoSift.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PhotoSift.MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PhotoSift.MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PhotoSift.Caption" TargetType="TextBlock" BasedOn="{StaticResource PhotoSift.MutedText}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A white rounded surface. Background stays the system window brush. -->
    <Style x:Key="PhotoSift.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="BorderBrush" Value="{StaticResource PhotoSift.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- High Contrast replaces the whole template rather than layering triggers on the
         themed one: only system colors, Highlight on hover, GrayText when disabled. The
         content is colored through TargetName because the style's High Contrast trigger
         owns the control's Foreground and outranks template triggers. -->
    <ControlTemplate x:Key="PhotoSift.HighContrastButtonTemplate" TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="8" SnapsToDevicePixels="True"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="PhotoSift.HighContrastSwitchTemplate" TargetType="CheckBox">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" VerticalAlignment="Center"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="2">
                <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left"
                         Fill="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsEnabled" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Buttons. One template; the variants only change colors. -->
    <Style x:Key="PhotoSift.Button" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource PhotoSift.FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        <Setter Property="BorderBrush" Value="{StaticResource PhotoSift.BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="8" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PhotoSift.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PhotoSift.PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Template" Value="{StaticResource PhotoSift.HighContrastButtonTemplate}" />
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PhotoSift.PrimaryButton" TargetType="Button" BasedOn="{StaticResource PhotoSift.Button}">
        <Setter Property="Background" Value="{StaticResource PhotoSift.AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PhotoSift.AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="8" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PhotoSift.AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PhotoSift.AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PhotoSift.LargePrimaryButton" TargetType="Button" BasedOn="{StaticResource PhotoSift.PrimaryButton}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="22,9" />
    </Style>

    <!-- On/off switch drawn over a real CheckBox, so commands, automation names and
         keyboard behavior stay those of a CheckBox. -->
    <Style x:Key="PhotoSift.SwitchCheckBox" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource PhotoSift.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                BorderBrush="{StaticResource PhotoSift.MutedTextBrush}" BorderThickness="1.5">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="4,0" HorizontalAlignment="Left"
                                     Fill="{StaticResource PhotoSift.MutedTextBrush}" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource PhotoSift.AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource PhotoSift.AccentBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Width" Value="16" />
                            <Setter TargetName="Knob" Property="Height" Value="16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Template" Value="{StaticResource PhotoSift.HighContrastSwitchTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A read-only path shown as text rather than as an input box. -->
    <Style x:Key="PhotoSift.PathText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PhotoSift.FocusVisual}" />
    </Style>

    <ControlTemplate x:Key="PhotoSift.HighContrastStepTemplate" TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="10" Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </MultiTrigger>
            <!-- Step content is the button's logical child, so it inherits the button's
                 Foreground rather than the presenter's; set both. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Workflow step in the left rail. -->
    <Style x:Key="PhotoSift.StepButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource PhotoSift.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="10" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PhotoSift.SubtleFillBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Template" Value="{StaticResource PhotoSift.HighContrastStepTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Review: a whole card that opens something (a kind or a set). In High Contrast it
         keeps system colors and shows hover and the open item with a Highlight border. -->
    <ControlTemplate x:Key="PhotoSift.HighContrastCardTemplate" TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="10" Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PhotoSift.CardButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource PhotoSift.FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        <Setter Property="BorderBrush" Value="{StaticResource PhotoSift.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="10" SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PhotoSift.BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PhotoSift.PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Template" Value="{StaticResource PhotoSift.HighContrastCardTemplate}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A photo thumbnail that opens the photo in the viewer. -->
    <Style x:Key="PhotoSift.ThumbnailButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource PhotoSift.FocusVisual}" />
        <Setter Property="Background" Value="{StaticResource PhotoSift.SubtleFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PhotoSift.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="8" ClipToBounds="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PhotoSift.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Colored mark for a Review kind; bound to anything with a Category property. -->
    <Style x:Key="PhotoSift.KindMark" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{StaticResource PhotoSift.BorderStrongBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Category}" Value="Exact">
                <Setter Property="Background" Value="{StaticResource PhotoSift.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Near">
                <Setter Property="Background" Value="{StaticResource PhotoSift.LookAlikeBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Uncertain">
                <Setter Property="Background" Value="{StaticResource PhotoSift.MaybeSimilarBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A small rounded label on a photo card. -->
    <Style x:Key="PhotoSift.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,4,6,0" />
        <Setter Property="Background" Value="{StaticResource PhotoSift.SubtleFillBrush}" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="PhotoSift.HighContrastKeepRemoveTemplate" TargetType="CheckBox">
        <StackPanel>
            <Border x:Name="Track" CornerRadius="8" Padding="2" HorizontalAlignment="Left" BorderThickness="2"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="KeepPart" CornerRadius="6" Padding="14,4"
                            Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}">
                        <TextBlock x:Name="KeepText" Text="Keep" FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    </Border>
                    <Border x:Name="RemovePart" CornerRadius="6" Padding="14,4" Background="Transparent">
                        <TextBlock x:Name="RemoveText" Text="Remove" FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    </Border>
                </StackPanel>
            </Border>
            <ContentPresenter x:Name="Reason" Margin="0,4,0,0" Visibility="Collapsed"
                              TextElement.Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </ContentPresenter.Resources>
            </ContentPresenter>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="KeepPart" Property="Background" Value="Transparent" />
                <Setter TargetName="KeepText" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter TargetName="RemovePart" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter TargetName="RemoveText" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter TargetName="KeepPart" Property="Background" Value="Transparent" />
                <Setter TargetName="RemovePart" Property="Background" Value="Transparent" />
                <Setter TargetName="KeepText" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter TargetName="RemoveText" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter TargetName="Reason" Property="Visibility" Value="Visible" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Keep / Remove drawn over the real Review selection CheckBox: checked means
         "marked for removal". The command, automation name and keyboard behavior stay
         those of the CheckBox; the eligibility text shows only when it can't change. -->
    <Style x:Key="PhotoSift.KeepRemoveToggle" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource PhotoSift.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel>
                        <Border x:Name="Track" CornerRadius="8" Padding="2" HorizontalAlignment="Left" BorderThickness="1"
                                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                BorderBrush="{StaticResource PhotoSift.BorderStrongBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="KeepPart" CornerRadius="6" Padding="14,4"
                                        Background="{StaticResource PhotoSift.SuccessSoftBrush}">
                                    <TextBlock x:Name="KeepText" Text="Keep" FontWeight="SemiBold"
                                               Foreground="{StaticResource PhotoSift.SuccessBrush}" />
                                </Border>
                                <Border x:Name="RemovePart" CornerRadius="6" Padding="14,4" Background="Transparent">
                                    <TextBlock x:Name="RemoveText" Text="Remove" FontWeight="SemiBold"
                                               Foreground="{StaticResource PhotoSift.MutedTextBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ContentPresenter x:Name="Reason" Margin="0,4,0,0" Visibility="Collapsed"
                                          TextElement.FontSize="12"
                                          TextElement.Foreground="{StaticResource PhotoSift.MutedTextBrush}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="KeepPart" Property="Background" Value="Transparent" />
                            <Setter TargetName="KeepText" Property="Foreground" Value="{StaticResource PhotoSift.MutedTextBrush}" />
                            <Setter TargetName="RemovePart" Property="Background" Value="{StaticResource PhotoSift.DangerBrush}" />
                            <Setter TargetName="RemoveText" Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource PhotoSift.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Reason" Property="Visibility" Value="Visible" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Template" Value="{StaticResource PhotoSift.HighContrastKeepRemoveTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
